# Copy to .env in the repository root, then use your pgAdmin connection values.
# URL-encode special characters in the password (for example, @ becomes %40).
DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5432/queuesmart
PORT=3001

# Optional: a SEPARATE disposable PostgreSQL database for integration tests.
# TEST_DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5432/queuesmart_test
